# Google Threat Intelligence (GTI) / VirusTotal v3 API Configuration
# Supports standard API key (x-apikey) or OAuth2 Bearer token (ya29....)
GTI_KEY=your_gti_or_virustotal_api_key_here

# Optional: Override base API endpoint and directories
GTI_BASE_URL=https://www.virustotal.com/api/v3
MEMHUNTER_OUTPUT_DIR=output
MEMHUNTER_TMP_DIR=/tmp
MEMHUNTER_MAX_DUMP_MB=1500
MEMHUNTER_DOWNLOAD_TIMEOUT=180
